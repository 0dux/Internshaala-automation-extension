{
  "name": "internshala-saved-filters",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "Chrome extension + Tampermonkey userscript for saving Internshala searches and reusing application answers.",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-assets.ps1",
    "package": "node scripts/build-extension.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1"
  }
}
