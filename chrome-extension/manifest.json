{
  "manifest_version": 3,
  "name": "Internshala Saved Filters",
  "version": "1.3.0",
  "description": "Save Internshala searches and reuse answers to repeat application questions. Local-only; unofficial.",
  "minimum_chrome_version": "96",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Internshala Saved Filters",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://internshala.com/*",
        "https://www.internshala.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
